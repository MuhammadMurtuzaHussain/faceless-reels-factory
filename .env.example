# Copy is created for you by scripts/setup-env.sh as .env (git-ignored). Nothing here costs money.

# Generated automatically: lets the local n8n call the local Python API.
REELFACTORY_API_TOKEN=
REELFACTORY_API_URL=http://127.0.0.1:8765

# Telegram (free): bot token from @BotFather, your numeric user ID from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

# ElevenLabs (paid plan, your voice clone): speaks each finished script so you don't record by hand.
# API key: elevenlabs.io -> Developers -> API Keys (needs Text to Speech access).
# Voice ID: Voices -> your clone -> copy the ID. Leave both empty to keep recording yourself.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_v4   (overrides voice.model in config/style.json)

# Optional overrides
# N8N_PORT=5678
# REELFACTORY_WORKERS=8
