<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The API + n8n stack, started at login and restarted if it stops. Installed by scripts/install-launchd.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.reelfactory.stack</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__ROOT__/scripts/start-stack.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__PATH__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__ROOT__/logs/stack.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/logs/stack.log</string>
</dict>
</plist>
