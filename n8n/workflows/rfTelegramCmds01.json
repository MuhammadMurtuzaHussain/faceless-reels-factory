{
  "id": "rfTelegramCmds01",
  "name": "Reel Factory · 3 Telegram commands",
  "nodes": [
    {
      "id": "f0da486c-4b12-5ead-b1f6-3a53de47b0be",
      "name": "Every 10 seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "04b3e373-fd04-54dd-b13a-0c4a69e87abb",
      "name": "Telegram: get messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TELEGRAM_API_BASE }}/bot{{ $env.TELEGRAM_BOT_TOKEN }}/getUpdates",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "timeout",
              "value": "0"
            },
            {
              "name": "allowed_updates",
              "value": "[\"message\"]"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "18054ab2-6f1b-57c5-876d-85c3ae2b49b8",
      "name": "Messages in order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Telegram getUpdates -> ONE item holding all new messages in order, plus `ack`\n// (= highest update_id + 1) so the next node confirms them with Telegram right away;\n// confirmed updates are never delivered twice, even if runs overlap. The API then runs\n// the messages strictly one after another (so '/approve' always lands before '/published').\nconst updates = $input.first().json.result || [];\nif (!updates.length) return [];\nconst ack = Math.max(...updates.map(u => u.update_id)) + 1;\nconst messages = updates\n  .sort((a, b) => a.update_id - b.update_id)\n  .map(u => u.message || u.edited_message || {})\n  .map(m => ({ text: typeof m.text === 'string' ? m.text : '', chat_id: m.chat ? String(m.chat.id) : '' }));\nreturn [{ json: { ack, messages } }];"
      }
    },
    {
      "id": "66c91ac2-4491-5468-bcbf-4eb3d45fd1b6",
      "name": "Telegram: confirm received",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        -160
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TELEGRAM_API_BASE }}/bot{{ $env.TELEGRAM_BOT_TOKEN }}/getUpdates",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "offset",
              "value": "={{ $json.ack }}"
            },
            {
              "name": "limit",
              "value": "1"
            },
            {
              "name": "timeout",
              "value": "0"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "executeOnce": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "8ac71b87-34f3-5dde-85ac-f116291232ef",
      "name": "Run commands in order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        80
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.REELFACTORY_API_URL }}/commands",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Reel-Token",
              "value": "={{ $env.REELFACTORY_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messages: $json.messages }) }}",
        "options": {
          "timeout": 1800000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 400
            }
          }
        }
      }
    },
    {
      "id": "48e35076-80aa-5db2-8cb2-729b2cc93589",
      "name": "One item per reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// one item per command result, keeping their order\nreturn $input.first().json.results.map(r => ({ json: r }));"
      }
    },
    {
      "id": "f322680b-7780-5f36-ab54-a62f686d514a",
      "name": "Messages to send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        -40
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// one Telegram message per API response that has text to say\nreturn $input.all()\n  .filter(i => !i.json.idle && i.json.reply)\n  .map(i => ({ json: { text: i.json.reply } }));"
      }
    },
    {
      "id": "96bbf8a6-6940-5c8b-ae95-a2623997bd2e",
      "name": "Telegram: send message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        -40
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TELEGRAM_API_BASE }}/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: $json.text, parse_mode: 'HTML', link_preview_options: { is_disabled: true } }) }}",
        "options": {
          "timeout": 30000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 400
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "1140fa5e-597f-56bb-bfb9-1c243495b6cf",
      "name": "Files to send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// one item per attached file; choose the Telegram method by file kind\nconst methods = { contact: ['sendPhoto', 'photo'], video: ['sendVideo', 'video'] };  // cover goes as a file: full resolution\nconst out = [];\nfor (const i of $input.all()) {\n  if (i.json.idle) continue;\n  for (const f of (i.json.files || [])) {\n    const [method, field] = methods[f.kind] || ['sendDocument', 'document'];\n    out.push({ json: { ...f, method, field } });\n  }\n}\nreturn out;"
      }
    },
    {
      "id": "8d63c1d3-21e7-5021-b994-28010bbd08ed",
      "name": "Fetch file from API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.REELFACTORY_API_URL }}/file",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "kind",
              "value": "={{ $json.kind }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Reel-Token",
              "value": "={{ $env.REELFACTORY_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 120000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 400
            }
          },
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      }
    },
    {
      "id": "b9c66d11-5765-54d3-980d-f77556745e52",
      "name": "Telegram: send file",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1700,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TELEGRAM_API_BASE }}/bot{{ $env.TELEGRAM_BOT_TOKEN }}/{{ $('Files to send').item.json.method }}",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{ $env.TELEGRAM_CHAT_ID }}"
            },
            {
              "name": "caption",
              "value": "={{ $('Files to send').item.json.caption }}"
            },
            {
              "parameterType": "formBinaryData",
              "name": "={{ $('Files to send').item.json.field }}",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {
          "timeout": 300000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 400
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
